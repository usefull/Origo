{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build/debug",
                "-S",
                "${workspaceFolder}",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--config",
                "Debug",
                "--target",
                "origo",
                "-j",
                "4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake Configure (Debug)"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--target",
                "clean"
            ],
            "group": "build"
        },
        {
            "label": "Docker: Build Release Image",
            "type": "shell",
            "command": "docker",
            "args": [
                "build",
                "-t",
                "origo:release",
                "."
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Docker: Run Release Container",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-p",
                "8080:8080",
                "origo:release"
            ],
            "group": "build",
            "dependsOn": [
                "Docker: Build Release Image"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Docker: Run (without rebuild)",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-p",
                "8080:8080",
                "origo:release"
            ],
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}